{
  "$defs": {
    "PriceInput": {
      "additionalProperties": false,
      "properties": {
        "external_key": {
          "maxLength": 90,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "External Key",
          "type": "string"
        },
        "source_record_key": {
          "maxLength": 250,
          "minLength": 1,
          "title": "Source Record Key",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "bucket_duration": {
          "enum": [
            "1h",
            "1d"
          ],
          "title": "Bucket Duration",
          "type": "string"
        },
        "price_kind": {
          "enum": [
            "sale_median",
            "ask_min",
            "bid_max"
          ],
          "title": "Price Kind",
          "type": "string"
        },
        "currency": {
          "enum": [
            "USD",
            "CNY",
            "JPY",
            "EUR",
            "GBP"
          ],
          "title": "Currency",
          "type": "string"
        },
        "minor_units": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Minor Units",
          "type": "integer"
        },
        "volume": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        },
        "evidence_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Evidence Url",
          "type": "string"
        },
        "coverage": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Coverage",
          "type": "string"
        },
        "methodology": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Methodology",
          "type": "string"
        }
      },
      "required": [
        "external_key",
        "source_record_key",
        "observed_at",
        "bucket_duration",
        "price_kind",
        "currency",
        "minor_units",
        "evidence_url",
        "coverage",
        "methodology"
      ],
      "title": "PriceInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_code": {
      "maxLength": 90,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:/-]+$",
      "title": "Source Code",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/PriceInput"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Records",
      "type": "array"
    }
  },
  "required": [
    "source_code",
    "records"
  ],
  "title": "PriceBatch",
  "type": "object"
}
