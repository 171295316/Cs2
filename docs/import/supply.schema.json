          "type": "string"
        },
        "quantity": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "methodology_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Methodology Version",
          "type": "string"
        },
        "coverage_note": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Coverage Note",
          "type": "string"
        },
        "sampling_method": {
          "maxLength": 2000,
          "minLength": 1,
