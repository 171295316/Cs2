# Generate local secrets; never commit .env
POSTGRES_PASSWORD=
IMPORT_TOKEN=
DATABASE_URL=postgresql+psycopg://cs2:REPLACE_ME@localhost:5432/cs2
REDIS_URL=redis://localhost:6379/0
API_URL=http://localhost:8000

# Steam 官方已文档化的市场接口，仅服务端使用；默认禁用。
# 普通个人 Steam Web API Key 不等于发行商凭证或 CS2 访问权限。
STEAM_MARKET_ENABLED=0
STEAM_PUBLISHER_KEY=
STEAM_CS2_MARKET_PERMISSION_CONFIRMED=0
